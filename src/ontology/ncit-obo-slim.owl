AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C18270 "Inhaling smoke from tobacco in the form of a cigarette.")
AnnotationAssertion(rdfs:label obo:NCIT_C18270 "Cigarette Smoking")
SubClassOf(obo:NCIT_C18270 obo:NCIT_C17934)

# Class: obo:NCIT_C18272 (Substance Abuse)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C18272 "Maladaptive pattern of drug or alcohol use that may lead to social, occupational, psychological, or physical problems.")
AnnotationAssertion(rdfs:label obo:NCIT_C18272 "Substance Abuse")
SubClassOf(obo:NCIT_C18272 obo:NCIT_C19683)

# Class: obo:NCIT_C185297 (High-Intensity Interval Training)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C185297 "A type of cardiovascular exercise that alternates short periods of intense anaerobic exercise with less intense recovery periods.")
AnnotationAssertion(rdfs:label obo:NCIT_C185297 "High-Intensity Interval Training")
SubClassOf(obo:NCIT_C185297 obo:NCIT_C39773)

# Class: obo:NCIT_C19035 (Social Networking)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C19035 "Establishing relationships with individuals who have similar social or professional interests for the purposes of expanding knowledge and professional/social interaction. (Glanz et al: Heath Behavior & Health Education, 1990)")
AnnotationAssertion(rdfs:label obo:NCIT_C19035 "Social Networking")
SubClassOf(obo:NCIT_C19035 obo:NCIT_C19683)

