# Class: obo:NCIT_C103933 (Automotive Occupations)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C103933 "A class of professional or vocational positions of employment that involve work with automobiles.")
AnnotationAssertion(rdfs:label obo:NCIT_C103933 "Automotive Occupations")
SubClassOf(obo:NCIT_C103933 obo:NCIT_C25193)

# Class: obo:NCIT_C116448 (Ultrasound Tomography)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C116448 "The quantitative computation of data obtained via ultrasonography to create a three dimensional map of the imaged tissue.")
AnnotationAssertion(rdfs:label obo:NCIT_C116448 "Ultrasound Tomography")
SubClassOf(obo:NCIT_C116448 obo:NCIT_C16203)
SubClassOf(obo:NCIT_C116448 obo:NCIT_C16502)

# Class: obo:NCIT_C14289 (Helicobacter pylori)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C14289 "Bacteria that cause stomach inflammation (gastritis) and ulcers in the stomach. This bacteria is the most common cause of ulcers worldwide. It is often referred to as H. pylori. H. pylori infection is usually acquired from contaminated food and water and through person to person spread. The infection is common in crowded living conditions with poor sanitation. In countries with poor sanitation, 90% of the adult population can be infected. In the U.S., 30% of the adult population is infected. One out of six patients with H. pylori infection develops ulcers of the duodenum or the stomach. This bacteria is also believed to be associated with stomach cancer and a rare type of lymph gland tumor called gastric MALT lymphoma. Infected persons usually carry the infection indefinitely, unless treated with medications to eradicate the bacteria. (MedicineNet.com)")
AnnotationAssertion(rdfs:label obo:NCIT_C14289 "Helicobacter pylori")

# Class: obo:NCIT_C154219 (Resistance Training)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C154219 "Physical exercise that uses weight, or other forms of resistance, to induce muscle contraction and build strength, anaerobic endurance, and size of skeletal muscles. Typical exercises include leg and chest press, knee extension, leg curl, row, abdominal crunch, and bicep curl.")
AnnotationAssertion(rdfs:label obo:NCIT_C154219 "Resistance Training")
SubClassOf(obo:NCIT_C154219 obo:NCIT_C17708)

# Class: obo:NCIT_C154329 (Smoking)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C154329 "The act of puffing and/or inhaling the combustion products of a substance so as to be tasted and absorbed into the bloodstream.")
AnnotationAssertion(rdfs:label obo:NCIT_C154329 "Smoking")
SubClassOf(obo:NCIT_C154329 obo:NCIT_C19683)

# Class: obo:NCIT_C16203 (Clinical or Research Activity)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C16203 "Any specific activity undertaken during the course of a clinical study or research protocol.")
AnnotationAssertion(rdfs:label obo:NCIT_C16203 "Clinical or Research Activity")
SubClassOf(obo:NCIT_C16203 obo:NCIT_C43431)

# Class: obo:NCIT_C16273 (Alcohol Consumption)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C16273 "Consumption of liquids containing ethanol, including the behaviors associated with drinking the alcohol.")
AnnotationAssertion(rdfs:label obo:NCIT_C16273 "Alcohol Consumption")
SubClassOf(obo:NCIT_C16273 obo:NCIT_C19683)

# Class: obo:NCIT_C16502 (Diagnostic Imaging Testing)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C16502 "Any method that uses a visual display of structural or functional patterns of organs or tissues for diagnostic evaluation.")
AnnotationAssertion(rdfs:label obo:NCIT_C16502 "Diagnostic Imaging Testing")
SubClassOf(obo:NCIT_C16502 obo:NCIT_C16203)

# Class: obo:NCIT_C16522 (Drug Abuse)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C16522 "The use of a drug for a reason other than which it was intended or in a manner or in quantities other than directed.")
AnnotationAssertion(rdfs:label obo:NCIT_C16522 "Drug Abuse")
SubClassOf(obo:NCIT_C16522 obo:NCIT_C18272)

# Class: obo:NCIT_C16567 (Exercise)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C16567 "Activity that requires physical or mental exertion, especially when performed to develop or maintain fitness.")
AnnotationAssertion(rdfs:label obo:NCIT_C16567 "Exercise")
SubClassOf(obo:NCIT_C16567 obo:NCIT_C17708)

# Class: obo:NCIT_C16795 (Lifestyle)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C16795 "A manner of living that reflects the person's values and attitudes.")
AnnotationAssertion(rdfs:label obo:NCIT_C16795 "Lifestyle")
SubClassOf(obo:NCIT_C16795 obo:NCIT_C43431)

# Class: obo:NCIT_C16818 (Mammography)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C16818 "A type of radiography used specifically to examine breast tissue. The procedure utilizes a low-dose of x-rays or radiation to generate an image. A mammography exam or mammogram, is used as a screening tool to detect early breast cancer in women experiencing no symptoms and to detect and diagnose breast disease.")
AnnotationAssertion(rdfs:label obo:NCIT_C16818 "Mammography")
SubClassOf(obo:NCIT_C16818 obo:NCIT_C16502)

# Class: obo:NCIT_C17007 (Positron Emission Tomography)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C17007 "A technique for measuring the gamma radiation produced by collisions of electrons and positrons (anti-electrons) within living tissue. In positron emission tomography (PET), a subject is given a dose of a positron-emitting radionuclide attached to a metabolically active substance (for example, 2-fluoro-2-deoxy-D-glucose (FDG), which is similar to a naturally occurring sugar, glucose, with the addition of a radioactive fluorine atom). When living tissue containing the positron emitter is bombarded by electrons, gamma radiation produced by collisions of electrons and positrons is detected by a scanner, revealing in fine detail the tissue location of the metabolically-active substance administered.")
AnnotationAssertion(rdfs:label obo:NCIT_C17007 "Positron Emission Tomography")
SubClassOf(obo:NCIT_C17007 obo:NCIT_C16203)

# Class: obo:NCIT_C17009 (Poverty)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C17009 "A subjective and comparative term describing a lack of sufficient wealth (usually understood as capital, money, material goods, or resources especially natural resources) to live what is understood in a society as a \"normal\" life: for instance, to be capable of raising a healthy family, and especially educating children and participating in society. A person living in this condition of poverty is said to be poor. The meaning of \"sufficient\" varies widely across the different political and economic areas of the world.")
AnnotationAssertion(rdfs:label obo:NCIT_C17009 "Poverty")
SubClassOf(obo:NCIT_C17009 obo:NCIT_C17468)

# Class: obo:NCIT_C17054 (Radioactivity)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C17054 "The quality of emitting or the emission of corpuscular or electromagnetic radiations consequent to nuclear disintegration, a natural property of all chemical elements of atomic number above 83 and possible of induction in all other known elements.")
AnnotationAssertion(rdfs:label obo:NCIT_C17054 "Radioactivity")

# Class: obo:NCIT_C17127 (Sex Behavior)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C17127 "Behaviors involved with sexual arousal and/or intercourse.")
AnnotationAssertion(rdfs:label obo:NCIT_C17127 "Sex Behavior")
SubClassOf(obo:NCIT_C17127 obo:NCIT_C19683)

# Class: obo:NCIT_C17263 (Xeroradiography)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C17263 "A printing process of electrostatic electrophotography that uses a photoconductive insulating medium in conjunction with X-rays or gamma rays to produce latent electrostatic-charge patterns for achieving an observable pattern.")
AnnotationAssertion(rdfs:label obo:NCIT_C17263 "Xeroradiography")
SubClassOf(obo:NCIT_C17263 obo:NCIT_C38101)

# Class: obo:NCIT_C17427 (Smoking Cessation)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C17427 "Discontinuation of the habit of smoking.")
AnnotationAssertion(rdfs:label obo:NCIT_C17427 "Smoking Cessation")
SubClassOf(obo:NCIT_C17427 obo:NCIT_C19683)
SubClassOf(obo:NCIT_C17427 obo:NCIT_C43431)

# Class: obo:NCIT_C17468 (Socioeconomic Factors)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C17468 "Characteristics of a person such as education and occupation, used to describe the person's position in stratification systems, access to services, etc.")
AnnotationAssertion(rdfs:label obo:NCIT_C17468 "Socioeconomic Factors")
SubClassOf(obo:NCIT_C17468 obo:NCIT_C20188)

# Class: obo:NCIT_C17604 (Food Preparation)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C17604 "The process of taking raw food and producing a finished meal.  Investigations into the link between food preparation methods and human disease")
AnnotationAssertion(rdfs:label obo:NCIT_C17604 "Food Preparation")

# Class: obo:NCIT_C17708 (Physical Activity)

AnnotationAssertion(rdfs:label obo:NCIT_C17708 "Physical Activity")
SubClassOf(obo:NCIT_C17708 obo:NCIT_C43431)

