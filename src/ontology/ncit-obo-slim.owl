AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C17934 "The act of puffing and/or inhaling smoke from a lit cigarette, cigar, or pipe.")
AnnotationAssertion(rdfs:label obo:NCIT_C17934 "Tobacco Smoking")
SubClassOf(obo:NCIT_C17934 obo:NCIT_C154329)
SubClassOf(obo:NCIT_C17934 obo:NCIT_C18059)
SubClassOf(obo:NCIT_C17934 obo:NCIT_C19683)

