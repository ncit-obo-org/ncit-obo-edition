AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C20188 "Pertaining to the demographic and psychosocial environment in which a person lives.")
AnnotationAssertion(rdfs:label obo:NCIT_C20188 "Social Circumstances")

# Class: obo:NCIT_C20701 (Alcohol Abuse)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C20701 "The use of alcoholic beverages to excess, either on individual occasions (\"binge drinking\") or as a regular practice.")
AnnotationAssertion(rdfs:label obo:NCIT_C20701 "Alcohol Abuse")
SubClassOf(obo:NCIT_C20701 obo:NCIT_C18272)

# Class: obo:NCIT_C21057 (Isometric Exercise)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C21057 "An exercise that is performed by exerting force against an immovable object or by holding an object in a static position.")
AnnotationAssertion(rdfs:label obo:NCIT_C21057 "Isometric Exercise")
SubClassOf(obo:NCIT_C21057 obo:NCIT_C16567)

# Class: obo:NCIT_C25193 (Occupation)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C25193 "The principal activity that a person does to earn money.")
AnnotationAssertion(rdfs:label obo:NCIT_C25193 "Occupation")

# Class: obo:NCIT_C27851 (Human Papillomavirus Infection)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C27851 "An infectious process caused by a human papillomavirus. This infection can cause abnormal tissue growth.")
AnnotationAssertion(rdfs:label obo:NCIT_C27851 "Human Papillomavirus Infection")

# Class: obo:NCIT_C38040 (Bronchography)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C38040 "The radiographic examination of the tracheobronchial tree following the injection of a radiopaque material.")
AnnotationAssertion(rdfs:label obo:NCIT_C38040 "Bronchography")
