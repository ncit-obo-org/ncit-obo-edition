AnnotationAssertion(rdfs:label obo:NCIT_C19382 "Coping Skills")
SubClassOf(obo:NCIT_C19382 obo:NCIT_C43431)

# Class: obo:NCIT_C19683 (Personal Behavior)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C19683 "The observable response of a person.")
AnnotationAssertion(rdfs:label obo:NCIT_C19683 "Personal Behavior")
SubClassOf(obo:NCIT_C19683 obo:NCIT_C43431)

# Class: obo:NCIT_C19694 (Risk Reduction)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C19694 "Personal behaviors designed to minimize and control the probability and/or impact of unfortunate events.")
AnnotationAssertion(rdfs:label obo:NCIT_C19694 "Risk Reduction")
SubClassOf(obo:NCIT_C19694 obo:NCIT_C19683)

# Class: obo:NCIT_C19706 (Dietary Practices)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C19706 "Dietary Practices refers to a person's choices in food consumption.")
AnnotationAssertion(rdfs:label obo:NCIT_C19706 "Dietary Practices")
SubClassOf(obo:NCIT_C19706 obo:NCIT_C19683)

# Class: obo:NCIT_C20026 (Flame-Broiling)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C20026 "Cooking of meats over an open flame.  A cooking practice associated with increased risk of breast cancer.")
AnnotationAssertion(rdfs:label obo:NCIT_C20026 "Flame-Broiling")
SubClassOf(obo:NCIT_C20026 obo:NCIT_C19683)

# Class: obo:NCIT_C20080 (X-ray Angiography)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C20080 "Any nuclear medicine study that utilizes a radioactive tracer to image blood vessels or characterize blood flow.")
AnnotationAssertion(rdfs:label obo:NCIT_C20080 "X-ray Angiography")
SubClassOf(obo:NCIT_C20080 obo:NCIT_C16502)
SubClassOf(obo:NCIT_C20080 obo:NCIT_C38101)

# Class: obo:NCIT_C20175 (Myelography)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C20175 "The radiographic examination of the spinal cord and nerve roots following the injection of a contrast medium into the spinal subarachnoid space. The X-rays taken may highlight conditions such as spinal tumors, spinal cord swelling and herniated discs.")
AnnotationAssertion(rdfs:label obo:NCIT_C20175 "Myelography")
SubClassOf(obo:NCIT_C20175 obo:NCIT_C38101)

