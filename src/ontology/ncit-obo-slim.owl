AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C38101 "A radiographic procedure using the emission of x-rays to form an image of the structure penetrated by the radiation.")
AnnotationAssertion(rdfs:label obo:NCIT_C38101 "X-Ray Imaging")
SubClassOf(obo:NCIT_C38101 obo:NCIT_C16502)

# Class: obo:NCIT_C38102 (Abdominal Radiography)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C38102 "A radiographic procedure to form an image of the abdomen.")
AnnotationAssertion(rdfs:label obo:NCIT_C38102 "Abdominal Radiography")
SubClassOf(obo:NCIT_C38102 obo:NCIT_C38101)

# Class: obo:NCIT_C38103 (Chest Radiography)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C38103 "An x-ray examination of the chest.")
AnnotationAssertion(rdfs:label obo:NCIT_C38103 "Chest Radiography")
SubClassOf(obo:NCIT_C38103 obo:NCIT_C38101)

# Class: obo:NCIT_C39772 (Moderate Exercise)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C39772 "20-60 minutes of exercise which elevates your heart rate to 60-80% of your maximum heart rate performed at least 3-4 times per week.")
AnnotationAssertion(rdfs:label obo:NCIT_C39772 "Moderate Exercise")
SubClassOf(obo:NCIT_C39772 obo:NCIT_C16567)

# Class: obo:NCIT_C39773 (Strenuous Exercise)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C39773 "20-60 minutes of exercise which elevates your heart rate to 80-90% of your maximum heart rate performed at least 3-4 times per week.")
AnnotationAssertion(rdfs:label obo:NCIT_C39773 "Strenuous Exercise")
SubClassOf(obo:NCIT_C39773 obo:NCIT_C16567)

# Class: obo:NCIT_C43431 (Activity)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C43431 "An active process; excludes processes and mechanisms which fulfill biological functions.")
AnnotationAssertion(rdfs:label obo:NCIT_C43431 "Activity")

# Class: obo:NCIT_C53462 (Travel)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C53462 "The act of going from one place to another.")
AnnotationAssertion(rdfs:label obo:NCIT_C53462 "Travel")
SubClassOf(obo:NCIT_C53462 obo:NCIT_C43431)

# Class: obo:NCIT_C61508 (Cholangiography)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C61508 "The radiographic examination of the bile ducts after a contrast medium has been injected.")
AnnotationAssertion(rdfs:label obo:NCIT_C61508 "Cholangiography")
SubClassOf(obo:NCIT_C61508 obo:NCIT_C38101)

# Class: obo:NCIT_C63663 (Fasting)

