AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C178214 "The act of supporting or resisting the weight of something.")
AnnotationAssertion(rdfs:label obo:NCIT_C178214 "Weight Bearing")
SubClassOf(obo:NCIT_C178214 obo:NCIT_C43431)

