AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C18059 "Use of tobacco in any form, e.g., smoking, chewing or sniffing.")
AnnotationAssertion(rdfs:label obo:NCIT_C18059 "Tobacco Use")
SubClassOf(obo:NCIT_C18059 obo:NCIT_C19683)

