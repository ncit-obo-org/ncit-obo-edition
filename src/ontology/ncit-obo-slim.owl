AnnotationAssertion(rdfs:label obo:NCIT_C38049 "Cystography")
SubClassOf(obo:NCIT_C38049 obo:NCIT_C38101)

# Class: obo:NCIT_C38096 (Vaginography)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C38096 "A radiographic examination of the vagina using the intravaginal injection of contrast medium.")
AnnotationAssertion(rdfs:label obo:NCIT_C38096 "Vaginography")
SubClassOf(obo:NCIT_C38096 obo:NCIT_C38101)

